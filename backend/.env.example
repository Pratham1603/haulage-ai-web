# MongoDB Atlas or local MongoDB connection string.
# Example Atlas: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGO_URL=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority

# Optional. Defaults to haulage_ai when omitted.
DB_NAME=haulage_ai
MONGO_SERVER_SELECTION_TIMEOUT_MS=5000

# Optional frontend origin(s), comma-separated.
CORS_ORIGINS=http://localhost:3000

# Required for protected local development routes. Use a locally generated value; never commit it.
DEV_API_TOKEN=replace-with-a-local-development-token
DEV_API_ROLE=dispatcher

# JWT settings for local authentication. Use a long random value outside local development.
JWT_SECRET_KEY=replace-with-a-local-jwt-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# Voice defaults to local mock mode. ElevenLabs provides speech synthesis only;
# a separate telephony provider is required for outbound phone calls.
VOICE_PROVIDER=mock
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
